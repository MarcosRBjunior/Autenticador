NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Origens (separadas por vírgula) que podem chamar a API com cookies
CORS_ORIGIN=http://localhost:5173
# Quantos proxies ficam na frente do app: 0 em dev local, 1 na Vercel.
# Sem o valor certo na Vercel, todo mundo parece vir do mesmo IP no rate limit.
TRUST_PROXY=0

# Obrigatórias: a aplicação não inicia sem elas
# Suba o Mongo local com: docker compose up -d
MONGODB_URI=mongodb://127.0.0.1:27017/auth-system
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin inicial, criado com: npm run seed:admin
# Em produção a senha precisa ter 12+ caracteres com maiúscula, minúscula,
# número e símbolo. Rodar de novo não duplica nem altera o admin existente.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# E-mails de ativação de conta e reset de senha
# Endereço público do app, base dos links enviados. Fora de produção o padrão
# é http://localhost:PORT (as páginas EJS deste servidor). Com o front React
# (glass-login-react), use o endereço dele, ex.: http://localhost:5173: ele tem
# as telas /activate e /reset-password que os links abrem.
APP_URL=
# No Resend sem domínio verificado, use "Auth System <onboarding@resend.dev>":
# esse remetente de teste só entrega para o e-mail da própria conta Resend.
MAIL_FROM="Auth System <no-reply@example.com>"
# Obrigatórias em produção (Resend: host smtp.resend.com, usuário "resend",
# senha = API key). Sem domínio, o Gmail serve: host smtp.gmail.com, usuário =
# endereço Gmail, senha = senha de app (exige verificação em 2 etapas) e
# MAIL_FROM com o mesmo endereço. Em desenvolvimento, com SMTP_HOST vazio, os
# e-mails vão para o Ethereal e o log mostra o link para ver cada um.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
