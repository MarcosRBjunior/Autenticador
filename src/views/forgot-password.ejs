<%- include('partials/head', { title: 'Esqueci minha senha' }) %>
<%- include('partials/card-top', { heading: 'Esqueci minha senha' }) %>
<%- include('partials/messages') %>
<p class="gl-text">Informe o e-mail da conta. Se ele estiver cadastrado, mandamos um link para criar uma senha nova, válido por 30 minutos.</p>
<form class="gl-form" method="post" action="/forgot-password" novalidate>
  <%- include('partials/csrf') %>
  <%- include('partials/field', { name: 'email', label: 'E-mail', type: 'email', autocomplete: 'email', value: values.email }) %>
  <button type="submit" class="gl-btn gl-submit">Enviar link</button>
</form>
<p class="gl-footer"><a href="/login">Voltar ao login</a></p>
<%- include('partials/card-bottom') %>
<%- include('partials/foot') %>
