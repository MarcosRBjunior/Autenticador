<% const id = 'field-' + name; const fieldErrors = locals.errors && locals.errors[name]; %>
<div class="gl-field">
  <label class="gl-label" for="<%= id %>"><%= label %></label>
  <div class="gl-input-wrap">
    <input
      class="gl-input<%= type === 'password' ? ' has-icon' : '' %>"
      id="<%= id %>"
      name="<%= name %>"
      type="<%= type %>"
      autocomplete="<%= autocomplete %>"
      <% if (type !== 'password' && locals.value) { %>value="<%= value %>"<% } %>
      <% if (fieldErrors) { %>aria-invalid="true" aria-describedby="<%= id %>-error"<% } %>
    />
    <% if (type === 'password') { %>
      <button type="button" class="gl-eye" data-toggle-password aria-label="Mostrar senha" aria-pressed="false">
        <svg data-icon="hide" viewBox="0 0 36 36" fill="currentColor" aria-hidden="true"><path d="M25.19 20.4a6.78 6.78 0 0 0 .43-2.4a6.86 6.86 0 0 0-6.86-6.86a6.79 6.79 0 0 0-2.37.43L18 13.23a4.78 4.78 0 0 1 .74-.06A4.87 4.87 0 0 1 23.62 18a4.79 4.79 0 0 1-.06.75Z"/><path d="M34.29 17.53c-3.37-6.23-9.28-10-15.82-10a16.82 16.82 0 0 0-5.24.85L14.84 10a14.78 14.78 0 0 1 3.63-.47c5.63 0 10.75 3.14 13.8 8.43a17.75 17.75 0 0 1-4.37 5.1l1.42 1.42a19.93 19.93 0 0 0 5-6l.26-.48Z"/><path d="m4.87 5.78l4.46 4.46a19.52 19.52 0 0 0-6.69 7.29l-.26.47l.26.48c3.37 6.23 9.28 10 15.82 10a16.93 16.93 0 0 0 7.37-1.69l5 5l1.75-1.5l-26-26Zm9.75 9.75l6.65 6.65a4.81 4.81 0 0 1-2.5.72A4.87 4.87 0 0 1 13.9 18a4.8 4.8 0 0 1 .72-2.47Zm-1.45-1.45a6.85 6.85 0 0 0 9.55 9.55l1.6 1.6a14.91 14.91 0 0 1-5.86 1.2c-5.63 0-10.75-3.14-13.8-8.43a17.29 17.29 0 0 1 6.12-6.3Z"/></svg>
        <svg data-icon="show" hidden viewBox="0 0 36 36" fill="currentColor" aria-hidden="true"><path d="M33.62 17.53c-3.37-6.23-9.28-10-15.82-10S5.34 11.3 2 17.53l-.28.47l.26.48c3.37 6.23 9.28 10 15.82 10s12.46-3.72 15.82-10l.26-.48ZM17.8 26.43C12.17 26.43 7 23.29 4 18c3-5.29 8.17-8.43 13.8-8.43S28.54 12.72 31.59 18c-3.05 5.29-8.17 8.43-13.79 8.43Z"/><path d="M18.09 11.17A6.86 6.86 0 1 0 25 18a6.86 6.86 0 0 0-6.91-6.83Zm0 11.72A4.86 4.86 0 1 1 23 18a4.87 4.87 0 0 1-4.91 4.89Z"/></svg>
      </button>
    <% } %>
  </div>
  <% if (locals.hint) { %><p class="gl-hint"><%= hint %></p><% } %>
  <% if (fieldErrors) { %><p class="gl-field-error" id="<%= id %>-error"><%= fieldErrors[0] %></p><% } %>
</div>
