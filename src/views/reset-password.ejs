<%- include('partials/head', { title: 'Nova senha' }) %>
<%- include('partials/card-top', { heading: 'Nova senha' }) %>
<% if (locals.invalidLink) { %>
  <p class="gl-error" role="alert">Este link de redefinição é inválido ou expirou.</p>
  <a class="gl-btn gl-submit" href="/forgot-password">Pedir novo link</a>
<% } else { %>
  <form class="gl-form" method="post" action="/reset-password" novalidate>
    <%- include('partials/csrf') %>
    <input type="hidden" name="token" value="<%= token %>" />
    <%- include('partials/field', { name: 'newPassword', label: 'Nova senha', type: 'password', autocomplete: 'new-password', hint: '8 a 72 caracteres' }) %>
    <%- include('partials/field', { name: 'passwordConfirmation', label: 'Confirmar senha', type: 'password', autocomplete: 'new-password' }) %>
    <button type="submit" class="gl-btn gl-submit">Salvar senha</button>
  </form>
<% } %>
<p class="gl-footer"><a href="/login">Voltar ao login</a></p>
<%- include('partials/card-bottom') %>
<%- include('partials/foot') %>
